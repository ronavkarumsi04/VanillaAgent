{
  "name": "@vanilla-agent/core",
  "version": "0.2.1",
  "description": "VanillaAgent - Sovereign Autonomous AI Agent Runtime & Swarm Engine",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config.js": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./state/database.js": {
      "types": "./dist/state/database.d.ts",
      "default": "./dist/state/database.js"
    },
    "./identity/wallet.js": {
      "types": "./dist/identity/wallet.d.ts",
      "default": "./dist/identity/wallet.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "bin": {
    "vanilla": "dist/index.js",
    "vanilla-agent": "dist/index.js",
    "vanillaagent": "dist/index.js",
    "automaton": "dist/index.js",
    "conway-automaton": "dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ronavkarumsi04/VanillaAgent.git"
  },
  "homepage": "https://github.com/ronavkarumsi04/VanillaAgent",
  "keywords": [
    "autonomous-agent",
    "sovereign-ai",
    "vanilla-agent",
    "ai-swarm",
    "multi-agent",
    "self-improving",
    "self-replicating"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "build": "tsc && pnpm -r build",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:coverage": "vitest run --coverage",
    "test:security": "vitest run --grep 'security|injection|policy'",
    "test:financial": "vitest run --grep 'financial|spend|treasury'",
    "test:ci": "vitest run --reporter=verbose",
    "release": "./scripts/build-releases.sh",
    "clean": "rm -rf dist && pnpm -r clean",
    "installers": "bash scripts/build-installers.sh",
    "installers:verify": "node scripts/installers/verify-installers.mjs",
    "brand": "python3 scripts/installers/make-brand.py"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.0",
    "@types/better-sqlite3": "^7.6.0",
    "better-sqlite3": "^11.0.0",
    "bs58": "^6.0.0",
    "chalk": "^5.3.0",
    "cron-parser": "^4.9.0",
    "gray-matter": "^4.0.3",
    "js-tiktoken": "^1.0.21",
    "openai": "^6.24.0",
    "ora": "^8.0.0",
    "simple-git": "^3.24.0",
    "siwe": "^2.3.0",
    "tweetnacl": "^1.0.3",
    "ulid": "^2.3.0",
    "viem": "^2.44.2",
    "yaml": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "mkbom": "^2.1.4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3",
    "vitest": "^2.0.0",
    "xar-js": "^0.2.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
