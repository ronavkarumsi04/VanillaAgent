#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
# VanillaAgent — Web GUI launcher
# Starts the sovereign runtime and opens the control panel at
# http://localhost:3000 once the dashboard is serving.
# ─────────────────────────────────────────────────────────────
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT="$(cd -P "$(dirname "$SOURCE")" && pwd)"

PORT="${PORT:-${METRICS_PORT:-3000}}"

if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  TEAL=$'\033[38;2;45;212;191m'; BRAND=$'\033[38;2;20;184;166m'
  WHITE=$'\033[38;2;226;232;240m'; DIM=$'\033[2m'; RESET=$'\033[0m'; BOLD=$'\033[1m'
else
  TEAL=""; BRAND=""; WHITE=""; DIM=""; RESET=""; BOLD=""
fi

printf "\n"
printf "%s%s◆%s %s%sVanillaAgent%s %sv%s%s  %s— Sovereign Node%s\n" \
  "$TEAL" "$BOLD" "$RESET" "$BOLD" "$WHITE" "$RESET" "$DIM" "@@VERSION@@" "$RESET" "$DIM" "$RESET"
printf "  %sDashboard%s  %shttp://localhost:%s%s\n" "$BRAND" "$RESET" "$WHITE" "$PORT" "$RESET"
printf "  %sState%s      %s%s/.vanilla-agent%s\n" "$BRAND" "$RESET" "$WHITE" "${HOME:-~}" "$RESET"
printf "  %sStop%s       %sCtrl+C%s\n" "$BRAND" "$RESET" "$DIM" "$RESET"
printf "\n"

# Open the dashboard as soon as the runtime reports healthy (background, non-blocking)
node "$ROOT/lib/open-browser.mjs" --port "$PORT" >/dev/null 2>&1 &

PORT="$PORT" exec node "$ROOT/lib/bootstrap.mjs" core --run "$@"
